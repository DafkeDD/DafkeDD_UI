{
  "name": "@dafke/ui",
  "version": "0.2.0",
  "private": true,
  "description": "Dafke UI — een volledig eigen component library. Geen shadcn, geen Radix, geen externe UI-dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/index.css",
    "./styles/tokens": "./src/styles/tokens.css",
    "./styles/tailwind": "./src/styles/tailwind.css",
    "./*": "./src/components/*.tsx",
    "./motion": "./src/motion/index.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "motion": ">=12"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    }
  }
}
