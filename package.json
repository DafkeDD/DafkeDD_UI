{
  "name": "dafke-ui-monorepo",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run registry && npm run dev -w @dafke/docs",
    "build": "npm run registry && npm run build -w @dafke/docs",
    "registry": "node scripts/build-registry.mjs",
    "typecheck": "tsc -p packages/ui/tsconfig.json --noEmit && tsc -p apps/docs/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "cli": "node packages/cli/bin/dafke-ui.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "node scripts/ui-test.mjs --build",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
